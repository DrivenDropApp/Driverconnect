# ─── Server Environment — EXAMPLE FILE ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file!

NODE_ENV=development
PORT=5000

# MongoDB Atlas (recommended)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/driverconnect_dev?appName=<appName>
# Or local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/driverconnect_dev

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars_use_crypto_randomBytes
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_use_crypto_randomBytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Dev OTP — set to false in production
DEV_OTP_ENABLED=true
DEV_OTP=1234

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Admin seed credentials
ADMIN_EMAIL=admin@driverconnect.com
ADMIN_PASSWORD=AdminPass@123

# Redis (optional — for distributed rate limiting in production)
# REDIS_URL=redis://localhost:6379

# Cloudinary (optional — for document/photo uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Razorpay (optional — for payments)
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx

# Field encryption key (32+ chars — for encrypting bank details)
# FIELD_ENCRYPTION_KEY=CHANGE_ME_min_32_chars
